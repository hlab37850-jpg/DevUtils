<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout android:id="@+id/topToolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="10dp">
        <TextView android:id="@+id/tvAppTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DevUtils" android:textSize="22sp" android:textStyle="bold" android:gravity="center_vertical" android:paddingBottom="4dp" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnToggleTheme" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◐ الوضع" />
                <Button android:id="@+id/btnHistory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◷ السجل" />
                <Button android:id="@+id/btnDeveloperCenter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مركز التطوير" />
                <Button android:id="@+id/btnExportSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="تصدير" />
                <Button android:id="@+id/btnImportSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="استيراد" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <RadioButton
                android:id="@+id/rbJson"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="JSON"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbBase64"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Base64"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbHash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مولد Hash"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="محول URL"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbUuid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مولد UUID"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbRegex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مختبر Regex"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbWordCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عداد الكلمات"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbCaseConverter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="محول النصوص"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbHttp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عميل HTTP"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbJwt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="محلل JWT"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbMockData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بيانات وهمية"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbCommitMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مولد Commit"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbGitCommand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="محول Git Commands"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbGitignore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مولد .gitignore"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbDateDiff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حاسبة التواريخ"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbDuplicateRemover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مزيل التكرارات" />
        </RadioGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvToolTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="منسق JSON"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />


    <LinearLayout android:id="@+id/llHttpInputs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginBottom="8dp">
        <EditText android:id="@+id/etHttpUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="رابط URL مثل https://httpbin.org/get" android:inputType="textUri" android:singleLine="true" android:padding="8dp" />
        <RadioGroup android:id="@+id/rgHttpMethod" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbHttpGet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="GET" />
            <RadioButton android:id="@+id/rbHttpPost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POST" />
        </RadioGroup>
        <EditText android:id="@+id/etHttpBody" android:layout_width="match_parent" android:layout_height="88dp" android:gravity="top|start" android:hint="Body اختياري لـ POST (نص أو JSON)" android:inputType="textMultiLine" android:padding="8dp" />
        <Button android:id="@+id/btnHttpSend" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="إرسال الطلب" />
    </LinearLayout>
    <LinearLayout android:id="@+id/llJwtInputs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginBottom="8dp">
        <EditText android:id="@+id/etJwtToken" android:layout_width="match_parent" android:layout_height="88dp" android:gravity="top|start" android:hint="ألصق JWT هنا..." android:inputType="textMultiLine" android:padding="8dp" />
        <Button android:id="@+id/btnJwtDecode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فك التشفير" />
    </LinearLayout>
    <LinearLayout android:id="@+id/llMockActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginBottom="8dp">
        <Button android:id="@+id/btnGenerateMock" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="توليد بيانات" />
    </LinearLayout>


    <LinearLayout android:id="@+id/llCommitInputs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginBottom="8dp">
        <Spinner android:id="@+id/spCommitType" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/commit_types" />
        <EditText android:id="@+id/etCommitScope" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Scope اختياري، مثل auth" android:singleLine="true" android:inputType="text" />
        <EditText android:id="@+id/etCommitDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="وصف مختصر للتغيير (مطلوب)" android:singleLine="true" android:inputType="textCapSentences" />
        <EditText android:id="@+id/etCommitBody" android:layout_width="match_parent" android:layout_height="76dp" android:gravity="top|start" android:hint="تفاصيل إضافية اختيارية" android:inputType="textMultiLine" />
        <Button android:id="@+id/btnGenerateCommit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="توليد رسالة Commit" />
    </LinearLayout>
    <LinearLayout android:id="@+id/llGitCommandInputs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginBottom="8dp">
        <EditText android:id="@+id/etGitCommand" android:layout_width="match_parent" android:layout_height="76dp" android:gravity="top|start" android:hint="أدخل الأمر المراد تحويله..." android:inputType="textMultiLine" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="من:" />
        <Spinner android:id="@+id/spShellFrom" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/shell_types" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="إلى:" />
        <Spinner android:id="@+id/spShellTo" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/shell_types" />
        <Button android:id="@+id/btnConvertGitCommand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تحويل الأمر" />
    </LinearLayout>
    <LinearLayout android:id="@+id/llGitignoreInputs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginBottom="8dp">
        <Spinner android:id="@+id/spGitignoreType" android:layout_width="match_parent" android:layout_height="wrap_content" android:entries="@array/project_types" />
        <Button android:id="@+id/btnGenerateGitignore" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="توليد .gitignore" />
        <Button android:id="@+id/btnCopyGitignore" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="نسخ .gitignore" style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>
    <LinearLayout android:id="@+id/llDateDiffInputs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginBottom="8dp">
        <EditText android:id="@+id/etStartDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="تاريخ البداية YYYY-MM-DD" android:inputType="date" android:singleLine="true" />
        <EditText android:id="@+id/etEndDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="تاريخ النهاية YYYY-MM-DD" android:inputType="date" android:singleLine="true" />
        <Button android:id="@+id/btnCalculateDateDiff" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="حساب الفرق" />
        <TextView android:id="@+id/tvDiffYears" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="السنوات: —" android:padding="4dp" />
        <TextView android:id="@+id/tvDiffMonths" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الأشهر: —" android:padding="4dp" />
        <TextView android:id="@+id/tvDiffDays" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الأيام: —" android:padding="4dp" />
        <TextView android:id="@+id/tvDiffTotalDays" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="إجمالي الأيام: —" android:padding="4dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etInput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:hint="ألصق JSON هنا..."
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:background="@android:drawable/edit_text"
        android:padding="8dp" />

    <EditText
        android:id="@+id/etRegexPattern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="نمط Regex، مثال: \\d+"
        android:singleLine="true"
        android:inputType="text"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:padding="8dp" />

    <LinearLayout
        android:id="@+id/llJsonActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnFormat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="تنسيق" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="مسح"
            style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llBase64Actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnEncode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="تشفير (Encode)" />

        <Button
            android:id="@+id/btnDecode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="فك تشفير (Decode)"
            style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llHashActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnGenerateHash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="توليد Hash" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llUrlActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnUrlEncode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="تشفير URL" />

        <Button
            android:id="@+id/btnUrlDecode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="فك تشفير URL"
            style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llUuidActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnGenerateUuid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="توليد UUID جديد" />

        <Button
            android:id="@+id/btnCopyUuid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نسخ للحافظة"
            style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llRegexActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnRegexTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختبار" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llWordStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvWordCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عدد الكلمات: 0"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tvCharCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عدد الأحرف: 0"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tvLineCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عدد الأسطر: 0"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tvParagraphCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عدد الفقرات: 0"
            android:padding="6dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llCaseActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnCamelCase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="camelCase" />

        <Button
            android:id="@+id/btnSnakeCase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="snake_case" />

        <Button
            android:id="@+id/btnPascalCase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PascalCase" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llDuplicateActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnRemoveDuplicates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إزالة التكرارات" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOutputLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="النتيجة:"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end">
        <Button android:id="@+id/btnShareOutput" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مشاركة النتيجة" style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/svOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/etOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0F0F0"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:fontFamily="monospace" />
    </ScrollView>
</LinearLayout>
