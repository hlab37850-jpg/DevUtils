<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <RadioButton
                android:id="@+id/rbJson"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="JSON"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbBase64"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Base64"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbHash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مولد Hash"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="محول URL"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbUuid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مولد UUID"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbRegex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مختبر Regex"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbWordCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عداد الكلمات"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbCaseConverter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="محول النصوص"
                android:paddingEnd="12dp" />

            <RadioButton
                android:id="@+id/rbDuplicateRemover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مزيل التكرارات" />
        </RadioGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvToolTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="منسق JSON"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etInput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:hint="ألصق JSON هنا..."
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:background="@android:drawable/edit_text"
        android:padding="8dp" />

    <EditText
        android:id="@+id/etRegexPattern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="نمط Regex، مثال: \\d+"
        android:singleLine="true"
        android:inputType="text"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:padding="8dp" />

    <LinearLayout
        android:id="@+id/llJsonActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnFormat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="تنسيق" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="مسح"
            style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llBase64Actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnEncode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="تشفير (Encode)" />

        <Button
            android:id="@+id/btnDecode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="فك تشفير (Decode)"
            style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llHashActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnGenerateHash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="توليد Hash" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llUrlActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnUrlEncode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="تشفير URL" />

        <Button
            android:id="@+id/btnUrlDecode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="فك تشفير URL"
            style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llUuidActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnGenerateUuid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="توليد UUID جديد" />

        <Button
            android:id="@+id/btnCopyUuid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نسخ للحافظة"
            style="?attr/materialButtonOutlinedStyle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llRegexActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnRegexTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختبار" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llWordStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvWordCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عدد الكلمات: 0"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tvCharCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عدد الأحرف: 0"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tvLineCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عدد الأسطر: 0"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tvParagraphCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عدد الفقرات: 0"
            android:padding="6dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llCaseActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnCamelCase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="camelCase" />

        <Button
            android:id="@+id/btnSnakeCase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="snake_case" />

        <Button
            android:id="@+id/btnPascalCase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PascalCase" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llDuplicateActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnRemoveDuplicates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إزالة التكرارات" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOutputLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="النتيجة:"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:id="@+id/svOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/etOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0F0F0"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:fontFamily="monospace" />
    </ScrollView>
</LinearLayout>
